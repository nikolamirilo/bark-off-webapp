# Copy to .env for local runs (node tools/serve.mjs reads it), and set the same three in the
# host's environment variables for the deployed site. .env is gitignored: the key is a
# password to your sending domain, so it never goes in a commit.

# From the API keys page at https://resend.com/api-keys. Sending permission is enough.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# The sender. The domain has to be verified at https://resend.com/domains first. Until it is,
# leave this unset: the fallback is onboarding@resend.dev, which Resend accepts with no setup
# but will only deliver to the address that owns the Resend account. That is enough to see
# your own signup notifications, and not enough to confirm anybody else's signup.
MAIL_FROM=BarkOff <noreply@barkoff.app>

# Where a signup lands. Defaults to barkoffapp@gmail.com.
MAIL_TO=barkoffapp@gmail.com
